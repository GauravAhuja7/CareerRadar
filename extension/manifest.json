{
  "manifest_version": 3,
  "name": "CareerRadar — Real-Time Job Fit & Decision Arbitrator",
  "version": "1.5.2",
  "description": "Ambient job fit arbitrator, experience calculator, and career decision engine powered by TypeSafe Jev System One. Works on LinkedIn, Google Careers, Indeed, Wellfound, YC, Greenhouse, Lever, Ashby, and all company career pages.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "CareerRadar Jev System One"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.google.com/about/careers/*",
        "*://careers.google.com/*",
        "*://*.wellfound.com/*",
        "*://*.angel.co/*",
        "*://*.workatastartup.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.amazon.jobs/*",
        "*://*.smartrecruiters.com/*",
        "*://*.icims.com/*",
        "*://*.jobvite.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
